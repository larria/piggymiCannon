{
  "name": "piggy-ballistics",
  "version": "5.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4175 --strictPort",
    "build": "tsc --noEmit && vite build && npm run check:size",
    "build:pages": "tsc --noEmit && vite build --mode pages && npm run check:size",
    "check:size": "node scripts/check-release-size.mjs",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages -d dist --nojekyll",
    "preview": "vite preview --host 0.0.0.0 --port 4176",
    "preview:pages": "vite preview --mode pages --host 0.0.0.0 --port 4177",
    "test:browser": "playwright test",
    "test": "tsx --test tests/*.test.ts",
    "test:ai": "tsx --test tests/ai.test.ts",
    "bench:render": "tsx scripts/render-baseline.ts",
    "lab:pixi": "vite --host 127.0.0.1 --port 4180 --strictPort",
    "test:pixi-prep": "tsc --project tsconfig.preparation.json && playwright test --config playwright.preparation.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "24.19.2",
    "gh-pages": "^6.3.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "pixi.js": "8.23.0"
  }
}
