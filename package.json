{
  "name": "piggy-ballistics",
  "version": "2.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4175 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages -d dist --nojekyll",
    "preview": "vite preview --host 0.0.0.0 --port 4176",
    "preview:pages": "vite preview --mode pages --host 0.0.0.0 --port 4177",
    "test:browser": "playwright test",
    "test": "tsx --test tests/*.test.ts",
    "test:ai": "tsx --test tests/ai.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "gh-pages": "^6.3.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
